; DAY10体験版の交流・雑談本文。各行は話題、三択、三つの返答。
*start
[iscript]
window.fiaDay10Dialogue = {
    people: {
        airan: {
            afternoon: [
                ['お芋の端っこ、少し焦げたくらいが好きなんです。古虫さんは？', ['俺も端がいい', '真ん中が好きだ', 'そんなに違うか？'], ['じゃあ端っこを半分こしましょう。今日は、先に私が取りますね', 'じゃあちょうどいいですね。お皿、もう一枚取ってきます', '違いますよ。ほら、音がするでしょう？']],
                ['明日もこの時間、お茶を飲みませんか。今日は私から誘うって決めてたんです', ['明日もここで', '今から一杯どうだ', '明日は分からない'], ['はい。席は取らなくても大丈夫です。人がいたら二人で探しましょう', 'それもいいですね。お湯はまだあります', 'そうですね。会えたら、そのときにしましょう']]
            ],
            night: [
                ['この時間だと、廊下まで声が聞こえそうですね。小声でお話ししませんか', ['内緒話みたいだな', '椅子を近づける', '少しだけなら'], ['じゃあ、お昼の芋をもう一個取っておいた話も、内緒です', 'そこなら聞こえます。ありがとうございます', 'はい。もう遅いですもんね']],
                ['古虫さん、疲れてるときも立って話すんですね。椅子、私の分だけじゃないですよ', ['隣に座る', '顔に出てたか', 'もう少ししたら'], ['ふふ。これでやっと、目を見て話せますね', 'さっき椅子を避けたとき、壁に手をついてたので', 'じゃあ、ここに置いておきますね']]
            ]
        },
        ito: {
            afternoon: [
                ['古虫。食事まで仕事にするな。隣、空いてるぞ', ['座らせてもらう', '今日は何が出た？', '先に用事を済ませる'], ['そうそう。皿が来るまで、仕事の話はなしだ', '見てからのお楽しみ。昔も待てなかったな、お前', '冷めるぞ。まあ、帰ってきたら声をかけろ']],
                ['お前、コインを出すとき一度握り直す癖、まだあるんだな', ['そんな所まで見てたのか', 'そっちこそ変わらないな', '癖だと思わなかった'], ['たまたま見えただけだ。……前から何度も', 'へえ。じゃあ私の癖も一つ当ててみろ', '本人が気づかないから癖なんだろ']]
            ],
            night: [
                ['子供の頃も、夜更かしすると次の日に響いてたぞ', ['よく覚えてるな', 'お前も一緒だったろ', '今日は早く寝る'], ['よく待たされたからな。帰り道で何度も', 'あれはお前を置いて帰れなかっただけだ', 'じゃあ約束だ。私もそうする']],
                ['少し座っていく。昔話をしても、お前の診療の邪魔にはならないだろ', ['昔の遊びを話す', '今の話も聞きたい', '静かに座る'], ['あったな。あの遊び、負けた理由をずっと言い張ってた', '今か。なら明日の朝飯の話から始めよう', 'いい。こういう日もある']]
            ]
        },
        akehiru: {
            afternoon: [
                ['紀一、どうして道具を毎回違う所に戻すの。置き場くらい決めようよ', ['一緒に決める', 'どこなら使いやすい？', '先に使う分だけ貸して'], ['よし。今度から、戻す場所を僕に聞かないこと', '棚の手前。疲れてても届く所にしとこう', 'いいけど、戻すときには僕を呼んで']],
                ['休憩しよう。見張ってないと、紀一は五分も椅子にいないから', ['五分だけ座る', '明昼も一緒なら', '立ったままでいい'], ['じゃあ数える。……ほら、立ちそうになった', 'いいよ。僕も座りたかったし', 'それを休憩と呼んでる時点で駄目だよ']]
            ],
            night: [
                ['働いてるときより静かだね。少しは疲れた顔をしてもいいんじゃない？', ['もう疲れた', '明昼はどうなんだ', 'まだ大丈夫だ'], ['うん。それくらい、最初から言えばいいのに', '僕も座ってるだろ。それで分かってよ', '今の顔を鏡で見てから言って']],
                ['話すことがないなら、ここで湯が冷めるのを待っててもいいよ', ['黙って湯を飲む', '明日も来るか？', '先に戻る'], ['……熱かったね。ゆっくりでいいよ', '診察が混んでなければ。席は取らなくていいから', 'うん。廊下で転ぶなよ']]
            ]
        },
        setsu: {
            afternoon: [
                ['棚にゲームがあった。二人でやるらしいよ。試してみない？', ['先手を譲る', 'まず決まりを読む', 'どこで見つけた？'], ['いいの？　じゃあ、あとでなしって言わないでね', 'うん。さっき駒を三つ余らせたの、たぶん私のせいだから', '毛布の下。宝探しみたいだったよ']],
                ['洗った布がうまく畳めない。手を貸して。今日はゲームじゃなくて本当に', ['片端を持つ', '一度広げてみよう', 'そのまま積んでしまう'], ['あ、揃った。二人で持つだけでこんなに違うんだね', 'うん。できたら、次は見てて。ひとりでやってみたい', '昨日それやったら、全部落ちちゃったんだよ']]
            ],
            night: [
                ['診療室って、夜はこんなに静かなんだ。もう少しここにいてもいい？', ['椅子を引く', '湯を持ってくる', '明日も早いぞ'], ['ありがとう。明かりはそのままにしておいて', 'じゃあ私、お湯を冷ます係ね', '分かってる。少しだけだから']],
                ['朝になったら何がしたい？　仕事に行く前の、小さいこと', ['二人でお茶を飲む', 'もう一度寝る', '朝になって考える'], ['いいね。私が二人分いれておく', 'それ、ちょっと羨ましい。私もそうしようかな', 'じゃあ私も、一緒に考えていい？']]
            ]
        },
        syuuichi: {
            afternoon: [
                ['紀一、余った箱で模型を作れそうなんだ。ちょっと見ていけよ', ['何を作るんだ？', '片側を押さえる', 'それは備品じゃないか'], ['車だよ。ほら、まだ車輪のない車', '助かる。こういう時だけ、お前は言う前に手が出るな', '許可は取った。お前が言うと思って、ちゃんと']],
                ['飯が冷める前に来いって、昨日も言った気がするんだがな', ['今日は座る', '昨日は悪かった', 'お前はもう食べたか'], ['じゃあ俺も。先に食べるとつまんねえからさ', '謝るほどじゃねえよ。今日は来たんだから', 'まだ。お前が来るまで汁だけ残しといた']]
            ],
            night: [
                ['俺の顔を見てまた怪我かと思ったろ。今日はただ話しに来ただけだ', ['座れよ', '顔に出てたか', '次は先に言ってくれ'], ['ああ。今日は笑える話をしにきたんだ', 'ひどい顔してた。俺が先に診てやろうかと思ったくらい', 'はいはい。じゃあ明日は、ノックを三回な']],
                ['お前がちゃんと座ってんの、今日はじめて見たな', ['お前も座れ', 'そんなに見てたのか', 'すぐ戻るつもりだ'], ['ん。向かいじゃなくて隣でいいな', '一緒に飯を食おうと思えば、そりゃ見るさ', '五分くらい遅く戻っても、明日は来るぞ']]
            ]
        },
        tota: {
            afternoon: [
                ['手が空いたら声をかけてくれ。湯を沸かしたところだ', ['一緒に飲む', '何か手伝おうか', 'あとでもらう'], ['ああ。俺のも入れるつもりだった', 'カップだけ頼む。棚の下だ', '分かった。蓋をしておく']],
                ['椅子を一脚、診療室の外に出した。手が空いたら試しに座ってみてくれ', ['今、座ってみる', '何のためだ？', '患者にも使ってもらう'], ['よし。座った人間が一人いると、ほかの奴も座りやすい', '呼ばれるまで立って待つ奴が多くてな', 'ああ。それなら通路の幅も確かめておこう']]
            ],
            night: [
                ['診療室の前を通ると、夜でもたいてい明かりがついているな', ['今夜は少し話す', '遅くまで見回りか？', 'そろそろ消す'], ['じゃあ少し。外は冷えてきた', '最後に一周だけだ。ついでに扉を閉めてくる', '分かった。戻るときは廊下に段差があるぞ']],
                ['夕方に煎れた湯がまだ残ってる。冷めてはいるが、一口いるか', ['一杯もらう', '温め直そう', '東太が飲んでくれ'], ['ほら。今日の分はここで終いだ', 'そうするか。二人分、ついでに', 'じゃあ遠慮なく。悪くないぞ、冷めたのも']]
            ]
        },
        ayase: {
            afternoon: [
                ['患者の分とは別に、君の椅子も置いてある。休憩に使ってくれ', ['少し座っていく', 'いつ置いたんです？', '患者に回してください'], ['うん。仕事が始まるまで、話でもしていこう', '今朝だよ。君はもう患者のほうにいたからね', '患者の分は足りている。あとで使えばいい']],
                ['手当を覚えた者に、道具の場所も教えてやってくれ。自分で取りに行けるように', ['あとで一緒に回ります', 'もう教わった人もいます', '先に札を作ります'], ['助かるよ。君が席を外しても続けられる', 'そうか。覚えた者に次を教えてもらえるな', 'いいね。手が空いた者に任せられる']]
            ],
            night: [
                ['少し休めるうちに休んでおくといい。そういう時間も仕事のうちだ', ['今日は座ります', '綾瀬さんは休んでますか', 'あと少しだけ仕事を'], ['ああ。私も湯をもらって帰るよ', '今がそれだよ。君にも同じことを勧めている', 'なら、終えるところを一つ決めてから始めよう']],
                ['今夜は急ぎの用件はない。灯りが見えたから、寄っただけだ', ['少し話しますか', '珍しいですね', '今日はこれで戻ります'], ['うん。今日、食堂の席が足りなかった話でもするか', 'そうかな。急ぎの話がない日は、時々あるものだよ', 'おやすみ。帰りは廊下の灯りを落としてくれ']]
            ]
        }
    },
    shared: {
        afternoon: [
            ['余ったお茶があるよ。冷める前にどう？', ['一杯もらう', '一緒に飲もう', 'あとにする'], ['どうぞ。渋くなる前でよかった', 'いいよ。カップを二つ出そう', '蓋をしておくね']],
            ['棚の高い段、何を置くかまだ決めていないんだ', ['軽いものを置く', '踏み台を探す', '空けておこう'], ['うん、落ちてきても危なくないね', '手の届く所にあると助かるな', 'そうか。あとで必要になるかもしれない']],
            ['窓のそばに椅子を出そうと思うんだ', ['一脚運ぶ', '向きを変えてみる', '今のままでいい'], ['ありがとう。少し景色が見えるね', 'この向きなら二人で外を見られる', 'うん。寒ければ戻そう']],
            ['夕飯の味見を頼まれたんだけど、自分じゃもう分からなくて', ['一口味見する', '一緒に味を見る', '作った人に任せる'], ['どう？　それならこのまま出していいかな', '同じ味でも感じ方が違うもんだね', 'そうだね。そろそろ食べる時間だ']],
            ['布を干すところなんだ。外、まだ風があるかな', ['片端を持つ', '風を見に行く', '中に干しておく'], ['助かる。大きい布は一人だと難しいよ', 'うん。風が強すぎるなら中にしよう', 'それなら夜も気にせず済むね']],
            ['途中まで読んだ本があるんだ。今日は残りを読めそうで', ['どんな本か聞く', '隣で静かに座る', 'また今度聞く'], ['思っていたより笑える話だったよ', 'じゃあ、頁をめくる音だけで', '読み終えたら教えるね']],
            ['落ちていた鉛筆、削ったらまだ使えそうだよ', ['削って渡す', '使い道を聞く', '机に置いておく'], ['短いけど、まだ書けるね', '伝言を書くのに、一本あると助かるんだ', 'うん。使いたい人が取れる場所に']],
            ['明日の分のお湯を今から沸かしておこうかな', ['今の分も沸かす', '火を見ておく', '朝でいいと思う'], ['そうしよう。今の分は分けられるね', 'ありがとう。じゃあ入れ物を洗ってくる', '分かった。明日の仕事にしておく']],
            ['廊下の時計が止まってた。少し見てみたいんだ', ['外すのを手伝う', 'いつ止まった？', '別の時計で合わせよう'], ['落とさないように。反対を持って', '昼に見たときは動いてた気がする', 'それが早いね。時間、覚えてる？']],
            ['パンが少し余った。どう食べようか考えてたんだ', ['焼き直す', '誰かと分ける', '明日の朝に回す'], ['いい匂いになるね', 'うん、三つに切ってみよう', '朝にあると思うと、ちょっと嬉しいね']],
            ['休憩の椅子、一つだと取り合いになるね', ['もう一つ運ぶ', '順番を決める', '自分は立ってる'], ['そうだね。奥に予備があったよ', 'じゃあ、先に座っていいよ', 'じゃあ次は交代ね']],
            ['隣の部屋の扉、開けるたびに変な音がするんだ', ['一緒に見に行く', 'いつからか聞く', '今日は閉めておく'], ['じゃあ、もう一度だけゆっくり開けよう', '前より大きい気がする。明日は確かめよう', 'うん。寝てる人を起こさずに済むしね']],
            ['空き箱に名前を書いておくと使いやすいと思って', ['名前を一緒に決める', '札を作る', '箱を集めてくる'], ['じゃあ、見た人がすぐ分かる名前にしよう', 'ありがとう。付け替えもできるね', 'じゃあ、こっちは置き場を作っておく']]
        ],
        night: [
            ['少し座ってから戻ってもいい？', ['椅子を引く', '湯を出す', '静かに待つ'], ['ありがとう。座ったら落ち着いた', '温かい。今日は手が冷えてたみたい', 'うん。これくらい静かでいい']],
            ['今日はもう仕事の話をしなくていい時間にしたいな', ['夕飯の話をする', '昔好きだったことを聞く', 'しばらく黙る'], ['そうそう。最後に残った皿、誰が取ったか見た？', '今でも好きかもしれない。やる時間がなかっただけで', 'こういう時間、最近はなかったね']],
            ['ここは夜になるとずいぶん静かだね', ['廊下の音を聞く', '灯りを少し落とす', 'もう戻ろうか'], ['遠くで誰か歩いてる。足音だけなら分かるね', 'うん。これくらいが落ち着く', 'そうだね。また明日']],
            ['明日のことを考える前に、今日の話を少ししておきたくて', ['嬉しかったことを聞く', '自分から話す', '今日はよく眠ろう'], ['食堂で笑い声がしたことかな。珍しくなかったはずなのに', 'うん。続きを聞かせて', 'そうだね。寝て起きてからでもいい話だ']],
            ['眠る前に、温かいものが飲めたらと思って', ['湯を足す', '一緒に飲む', '毛布を貸す'], ['ありがとう。これで少し温まる', 'じゃあ半分ずつ。二人なら冷めないうちに飲めるね', '助かる。これなら部屋まで温かい']],
            ['外に出られたら何をするか、少し考えていたんだ', ['何をしたいか聞く', '自分の予定を話す', '外に出てから決めよう'], ['散歩かな。時間を気にせず歩きたい', 'いいね。叶ったら、あとで聞かせて', 'それもいいね。楽しみが一つ残る']]
        ]
    }
};
[endscript]
[return]
