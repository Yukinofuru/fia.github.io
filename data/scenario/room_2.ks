[ui_showChoices layout="encounter" fontSize="38" text1="思いつくままに話を続ける" target1="*A7Menu_choice0" text2="&(!f.encounter.values.usedEmpathy) ? ((f.encounter.values.hasEmpathy) ? '相手の心情に理解を示す' : 'まだ相手のことについてじっくり考えられていない') : ''" target2="*A7Menu_choice1" disable2="&!(f.encounter.values.hasEmpathy)" text3="&(!f.encounter.values.usedReasoning) ? ((f.encounter.values.hasReasoning) ? 'ここで起こったことを推理して話す' : 'まだここで起こったことについてうまく推理できていない') : ''" target3="*A7Menu_choice2" disable3="&!(f.encounter.values.hasReasoning)" text4="考え直す" target4="*A7Menu_choice3"]
[s]

*talk4Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="最後通牒を突き付けて、返事が無ければこじ開ける" target1="*talk4Menu_choice0" text2="何もしない" target2="*talk4Menu_choice1" text3="少し考え直す" target3="*talk4Menu_choice2"]
[s]

*empathyMenu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="人の助けを拒絶してしまうほど悲観的になっているのかもしれないとして、それも仕方ないとなだめる" target1="*empathyMenu_choice0" text2="心の病気や精神汚染を治すことのできる用意があると伝える" target2="*empathyMenu_choice1"]
[s]

*reason1Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="それが大量に現れて、ここに居た人を皆糸にしてしまったのでしょう？" target1="*reason1Menu_choice0" text2="それがいくつか現れて、ここに居た人を次々に糸にしていったのでしょう？" target2="*reason1Menu_choice1"]
[s]

*reason2Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="一番奥のゴミ袋だけ、持った時にコロコロと音がしたんです。" target1="*reason2Menu_choice0" text2="一番奥のゴミ袋だけ、大量のボビンが入っていたんです。" target2="*reason2Menu_choice1"]
[s]

*reason3Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="それをどうしてあんなところにも隠したのかは、分かりませんが……" target1="*reason3Menu_choice0" text2="二度目か、ひょっとすると三度目の出現があそこだったのかもしれません" target2="*reason3Menu_choice1"]
[s]

*reason4Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="ただ、未来から来た人でないと、これほどすらすらと推理することはできないはずですよ" target1="*reason4Menu_choice0" text2="何せ、未来の知識がなくたって、身近な人が被害に遭えば嫌でも理解できますからね" target2="*reason4Menu_choice1"]
[s]

*A8Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="あとは待つだけだ。" target1="*A8Menu_choice0"]
[s]

*A9Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="甘くておいしい。" target1="*A9Menu_choice0" text2="甘くておいしい。" target2="*A9Menu_choice1" text3="甘くておいしい。" target3="*A9Menu_choice2"]
[s]

*B1Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="もう1番診察室に行ってしまおうか？" target1="*B1Menu_choice0" text2="他の部屋も調べることにした。" target2="*B1Menu_choice1"]
[s]

*B2Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="もう1番診察室に行ってしまおうか？" target1="*B2Menu_choice0" text2="ばってん印の貼り紙がある隔離室を調べることにした。" target2="*B2Menu_choice1" text3="ごみ袋でいっぱいの隔離室を調べることにした。" target3="*B2Menu_choice2"]
[s]

*B3Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="もう1番診察室に行ってしまおうか？" target1="*B3Menu_choice0" text2="りんごマークの隔離室を調べることにした。" target2="*B3Menu_choice1" text3="しかし一か所だけ気になることが……" target3="*B3Menu_choice2"]
[s]

*B32Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="眩しくて目が慣れない。もっとよく見よう。" target1="*B32Menu_choice0" text2="ま、ホコリか虫かなんかだろう。" target2="*B32Menu_choice1"]
[s]

*B33Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="迷うな俺。こんなところで重大な何かを見逃しちゃいけない。" target1="*B33Menu_choice0" text2="冷静になれ俺。こんなところで目をやられて、急に後ろから襲われたらどうするんだ。" target2="*B33Menu_choice1"]
[s]

*B34Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="糸を巻いて遊ぶ。" target1="*B34Menu_choice0" text2="糸を巻いて遊ぶ。" target2="*B34Menu_choice1" text3="糸を巻いて遊ぶ。" target3="*B34Menu_choice2"]
[s]

*B4Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="袋をそっと開けて、上から覗き込む。" target1="*B4Menu_choice0" text2="いや、袋の中まで見るのは最後の最後と決めたんだ。" target2="*B4Menu_choice1"]
[s]

*B42Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="意を決して袋に手を突っ込む。" target1="*B42Menu_choice0" text2="一度冷静になるためにも、この部屋から離れよう。" target2="*B42Menu_choice1"]
[s]

*B43Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="糸を巻いて遊ぶ。" target1="*B43Menu_choice0" text2="糸を巻いて遊ぶ。" target2="*B43Menu_choice1" text3="糸を巻いて遊ぶ。" target3="*B43Menu_choice2"]
[s]

*endingAMenu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="あれが最善だったと開き直る" target1="*endingAMenu_choice0" text2="寝たのは認めるがそんなに長くは寝ていないと嘘をつく" target2="*endingAMenu_choice1"]
[s]

*endingBMenu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="少なくともあのときは本心だった" target1="*endingBMenu_choice0" text2="本当は必ず生きて帰るつもりだった" target2="*endingBMenu_choice1"]
[s]

*deathA1Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="いつまでも。" target1="*deathA1Menu_choice0" text2="いつまでも。" target2="*deathA1Menu_choice1" text3="いつまでも。" target3="*deathA1Menu_choice2"]
[s]

*deathA2Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="しあわせ。" target1="*deathA2Menu_choice0" text2="しあわせ。" target2="*deathA2Menu_choice1" text3="しあわせ。" target3="*deathA2Menu_choice2"]
[s]

*deathA3Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="頭をほどいていく。" target1="*deathA3Menu_choice0" text2="頭をほどいていく。" target2="*deathA3Menu_choice1" text3="頭をほどいていく。" target3="*deathA3Menu_choice2"]
[s]

*deathB1Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="いけるところまでいっちゃおう。" target1="*deathB1Menu_choice0" text2="いけるところまでいっちゃおう。" target2="*deathB1Menu_choice1" text3="いけるところまでいっちゃおう。" target3="*deathB1Menu_choice2"]
[s]

*deathB2Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="やめどきがわかんなくなるね。" target1="*deathB2Menu_choice0" text2="やめどきがわかんなくなるね。" target2="*deathB2Menu_choice1" text3="やめどきがわかんなくなるね。" target3="*deathB2Menu_choice2"]
[s]

*deathB3Menu
[encounterClear]
[ui_showChoices layout="encounter" fontSize="38" text1="もうわすれちゃった。" target1="*deathB3Menu_choice0" text2="もうわすれちゃった。" target2="*deathB3Menu_choice1" text3="もうわすれちゃった。" target3="*deathB3Menu_choice2"]
